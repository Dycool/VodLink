#include <windows.h>

1 ICON "vodlink.ico"

// Unsigned executables without version metadata are a common antivirus
// machine-learning false-positive trigger (e.g. Trojan:Win32/Wacatac.C!ml).
// Keep this block present and descriptive so the launcher looks like the
// legitimate installer it is.
1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "VodLink"
      VALUE "FileDescription", "VodLink Installer"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "VodLink-Windows-x64"
      VALUE "LegalCopyright", "\xA9 VodLink. MIT License."
      VALUE "OriginalFilename", "VodLink-Windows-x64.exe"
      VALUE "ProductName", "VodLink"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
